{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexa.ai/schemas/identity.v2",
  "title": "identity.v2",
  "description": "The identity.v2 contract: identity.v1 plus the dedicated Agent capability. Principal identifiers remain strings at JSON boundaries.",
  "$defs": {
    "Scope": {
      "description": "A capability a token carries: bot, tx, browser, or the dedicated agent capability.",
      "enum": ["bot", "tx", "browser", "agent"]
    },
    "ResourceKind": {
      "enum": ["meeting_transcript", "recording", "ws_subscribe"]
    },
    "Action": {
      "enum": ["read", "write", "admin"]
    },
    "ScopedToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "scopes", "expires_at"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "Owning principal. Numeric database ids are serialized as canonical decimal strings, never JSON numbers."
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Scope" }
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "WorkspaceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "enum": ["ro", "rw"] }
      }
    },
    "DispatchClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub", "lch", "ws", "iat", "exp"],
      "properties": {
        "sub": { "type": "string" },
        "lch": { "type": "string" },
        "ws": { "type": "array", "items": { "$ref": "#/$defs/WorkspaceGrant" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "iat": { "type": "integer" },
        "exp": { "type": "integer" }
      }
    },
    "AccessDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "subject", "resource_kind", "resource_id", "action", "reason"],
      "properties": {
        "allow": { "type": "boolean" },
        "subject": { "type": "string" },
        "resource_kind": { "$ref": "#/$defs/ResourceKind" },
        "resource_id": { "type": "string" },
        "action": { "$ref": "#/$defs/Action" },
        "reason": {
          "enum": ["owner", "not-owner", "default-deny", "missing-scope", "token-expired"]
        }
      }
    }
  }
}
